/* Textual TUI Stylesheet for little-harness-rich-tui */

Screen {
    background: $background;
    color: $foreground;
    layout: vertical;
    layers: base autocomplete;
}

/* App-wide thin scrollbars */
* {
    scrollbar-size-vertical: 1;
}

#message-stream {
    height: 1fr;
    padding: 1 2;
    background: $background;
}

#input-container {
    height: auto;
    background: $background;
    border-top: solid $surface;
    padding: 1 2;
}

ChatInputWidget {
    height: auto;
}

ChatInputWidget Input {
    border: round $text-muted;
    background: $surface;
}

ChatInputWidget Input:focus {
    border: round $primary;
}

.chat-bubble {
    margin: 0 0 1 0;
    padding: 0 1;
    background: transparent;
    transition: background 200ms;
}

.chat-bubble:hover {
    background: $panel 15%;
}

.chat-bubble.user {
    border-left: wide $primary;
}

.chat-bubble.assistant {
    border-left: wide $secondary;
}

.chat-bubble.system {
    border-left: wide $text-muted;
}

ReasoningBlockWidget {
    margin: 0 0 1 0;
    background: $panel 20%;
    border-left: wide $text-muted;
    padding: 0 1;
    height: auto;
}

ReasoningBlockWidget Collapsible {
    border: none;
    background: transparent;
}

ReasoningBlockWidget Static {
    color: $text-muted;
}

.tool-call-card {
    border: round $primary;
    background: $surface;
    margin: 1 2;
    padding: 1;
    height: auto;
    transition: border 200ms;
}

.tool-call-card:hover {
    border: round $accent;
}

#buttons-container {
    margin-top: 1;
    height: auto;
    align: left middle;
}

#buttons-container Button {
    margin-right: 2;
}

#status-container {
    margin-top: 1;
    height: auto;
}

#autocomplete-list {
    display: none;
    layer: autocomplete;
    background: $surface;
    border: round $primary;
    height: auto;
    max-height: 8;
    width: 60;
    dock: bottom;
    offset-y: -5;
    margin-left: 4;
}

Footer {
    background: $background;
    border-top: solid $surface;
}

Footer .footer--key {
    background: $surface;
    color: $primary;
}

Footer .footer--description {
    color: $foreground;
}

Footer .footer--highlight {
    background: $primary;
    color: $background;
}


